<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Device"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add a device to track battery level and daily usage."
            android:textColor="#64748B"
            android:textSize="15sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <EditText
                    android:id="@+id/etDeviceNameAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Device Name"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etDeviceTypeAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Device Type: Phone, Tablet, Laptop"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etBrandAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Brand: Apple, Samsung, Lenovo"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etModelAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Model"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etPhoneAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Phone Number for SMS Alert"
                    android:inputType="phone"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etBatteryLevelAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Battery Level %"
                    android:inputType="number"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etUsageHoursAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:hint="Daily Usage Hours"
                    android:inputType="numberDecimal"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/etNotesAddFragment"
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:hint="Notes: Check battery daily and reduce usage when status is red"
                    android:padding="14dp" />

                <Button
                    android:id="@+id/btnAddDevice"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#0F172A"
                    android:text="ADD DEVICE"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>